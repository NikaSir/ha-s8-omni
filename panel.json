{
  "panel": {
    "id": "s8_omni",
    "title": "Пылесос",
    "path": "/dashboard-s8-omni",
    "parent_path": "/dashboard-actions",
    "icon": "mdi:robot-vacuum",
    "owner": "ha-s8-omni",
    "expose_in_generated_ui": true,
    "preferred_view": "overview",
    "dashboard_version": "v0.7.15",
    "template": "NikaS Integration Panel Template v1.0",
    "frontend": {
      "module": "s8-omni-panel.js",
      "bundle": "self_contained",
      "runtime_historical_imports": false,
      "cache_busting": "query_string_dashboard_version",
      "asset_root": "frontend/assets",
      "asset_url_root": "/s8_omni/frontend/assets",
      "assets": [
        "assets/product-clean.jpg",
        "assets/product-dock.jpg",
        "assets/status-robot.jpg",
        "assets/status-station.jpg",
        "assets/status-water.jpg",
        "assets/status-dustbin.jpg"
      ],
      "product_art_delivery": "integration_local_static_assets",
      "product_art_states": [
        "clean",
        "dock"
      ],
      "status_thumbnail_delivery": "integration_local_static_assets"
    },
    "availability": {
      "current_truth": [
        "local_connection",
        "vacuum"
      ],
      "stale_values_are_current": false,
      "disable_device_actions_when_disconnected": true
    },
    "navigation": {
      "header_root_primary": "home_assistant_sidebar_menu",
      "header_detail_back": "return_to_parent_view",
      "header_action": "refresh",
      "header_grid": "48px_minmax_48px_mobile",
      "primary_navigation": "full_width_fixed_bottom_tab_bar",
      "active_tab": "inside_shared_bar",
      "floating_tab_bar": false,
      "browser_history_back": false,
      "views": [
        "overview",
        "cleaning",
        "station",
        "maintenance",
        "diagnostics"
      ],
      "view_responsibilities": {
        "overview": "approved_render_composition_with_live_verified_station_scene_frequent_actions_and_four_compact_statuses",
        "cleaning": "current_cleaning_metrics_key_profile_cards_and_separate_settings_drill_down",
        "station": "compact_station_state_summary_and_operations",
        "maintenance": "consumables_and_service",
        "diagnostics": "technical_state_and_raw_context"
      },
      "drill_down": {
        "cleaning-settings": {
          "parent_view": "cleaning",
          "back_behavior": "return_to_parent_view",
          "bottom_tab_bar": "preserved",
          "content_scope": "editable_cleaning_profile_only"
        }
      }
    },
    "mobile_fit": {
      "primary_viewport": "iPhone Pro Max portrait",
      "horizontal_scroll": false,
      "quick_actions": "compact_state_aware_three_equal_columns",
      "quick_action_icon_px": 34,
      "card_proportions": "approved_reference_compact",
      "typography_scale": "compact_balanced_mobile",
      "overview_target": "approved_target_mockup_composition",
      "overview_scene": "high_quality_static_product_art_plus_live_omni_status_overlay",
      "overview_scene_sources": [
        "robot_on_dock",
        "robot_status",
        "station_operations",
        "dp134",
        "dp135",
        "dp136"
      ],
      "overview_scene_synthetic_levels": false,
      "overview_scene_duplicate_operation_tiles": false,
      "status_layout": "four_compact_operational_cards_with_product_thumbnails",
      "status_sources": [
        "robot_status",
        "station_status",
        "water_level_not_exposed",
        "dustbin_level_not_exposed"
      ],
      "station_target": "typical_state_without_required_vertical_scroll",
      "station_summary_layout": "three_equal_compact_columns",
      "station_operation_density": "compact_without_reducing_touch_readability",
      "cleaning_root_actions": false,
      "cleaning_key_profile_cards": [
        "suction",
        "water"
      ],
      "cleaning_settings_secondary_summary": [
        "volume",
        "do_not_disturb"
      ],
      "compact_state_vocabulary": true,
      "hero_station_text_safe_zone": true,
      "split_words_inside_values": false,
      "status_heading": "Статусы",
      "touch_target_min_px": 44,
      "safe_area": true,
      "overview_scene_visual_depth": "approved_photographic_product_art",
      "overview_scene_verified_only": true
    },
    "workspace_transform": {
      "scope": "working_area_only",
      "shell_excluded": [
        "header",
        "bottom_navigation"
      ],
      "implementation": "translate3d_scale",
      "native_scroll": false,
      "css_zoom": false,
      "pinch_midpoint": true,
      "one_pointer_pan": true,
      "two_finger_double_tap_reset": true,
      "snap_to_100_percent": [
        0.97,
        1.03
      ],
      "persistent_per_entry_and_view": true,
      "permanent_zoom_controls": false
    }
  },
  "generated_ui": {
    "summary_entity_unique_id_suffix": "composite_status",
    "battery_entity_unique_id_suffix": "battery",
    "vacuum_entity_unique_id_suffix": "vacuum",
    "connection_entity_unique_id_suffix": "local_connection",
    "refresh_entity_unique_id_suffix": "refresh",
    "quick_actions": [
      "vacuum.start",
      "vacuum.return_to_base"
    ],
    "details_path": "/dashboard-s8-omni"
  },
  "ownership": {
    "direct_tuya_dp_writes_from_ui": false,
    "station_commands_require_public_integration_api": true,
    "map_requires_public_integration_api": true
  }
}
